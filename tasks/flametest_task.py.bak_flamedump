"""焰色反应任务（V7 文档 C1，13 步，一步一事件）。

13 步（严格按 LabUtopia_Action_Catalogue_v7 文档 C1）：
  P1 取表面皿置中央      P2 旋开稀盐酸瓶磨口塞   P3 滴管吸盐酸滴 2-3 滴（滴完盖塞归位）
  P4 点燃本生灯（蓝焰）  P5 铂丝蘸酸            P6 外焰灼烧
  P7 反复蘸酸+灼烧 3 次  P8 冷却 5s             P9 开样品瓶蘸粉末
  P10 灼烧 2-5s（受染）  P11 灯帽盖灭           P12 冲洗擦干归位
  P13 表面皿清洗归位

本任务不做机械臂运动（由 FlameTestTaskController 按 13 步驱动），只负责：
  1. kinematic 物体跟随（铂丝/表面皿/瓶塞/滴管/火柴/灯帽：夹爪闭合→跟随，张开→落位）
  2. 事件检测（位置 + dwell 帧数）：
     - 点燃：火柴头在灯口 -> 显示蓝色火焰（flame_outer + flame_inner）
     - 滴液：滴管口在表面皿上方 -> 3 颗盐酸滴（Droplet）-> 皿内酸液（DishAcid）
     - 受染：铂丝尖端在外焰中连续 150 帧 -> 显示 flame_stain_{flame_color}
       （火焰主体保持蓝色，只有铂丝接触处变色；离开火焰即隐藏）
     - 灭焰：灯帽盖到灯口 -> 隐藏全部火焰
     - 冲洗：铂丝尖端/表面皿在洗瓶喷嘴下 -> 显示水柱（WaterJet）
  3. 落位规则：表面皿 z 校正；塞子按位置盖回瓶口或落桌面；滴管/火柴/铂丝归原位；
     灯帽直接盖在灯口

场景（assets/chemistry_lab/lab_flametest/lab_flametest.usd，桌面 z=0.80）：
  SampleDish(0.32,-0.22) HClBottle(0.12,0.02) Dropper(0.12,-0.10 竖立)
  PlatinumWire(0.20,-0.14 rotateY150° 尖端触桌) SampleBottle(0.20,0.12)
  BunsenBurner(0.36,0.18) Match(0.50,0.24 横置头朝灯) WashBottle(0.40,-0.10)
  铂丝几何：手柄中心相对 prim 原点 (0.028,0,-0.0485)，尖端相对手柄 (0.05475,0,-0.09303)
"""
import numpy as np
from pxr import Usd, UsdGeom
from isaacsim.core.utils.prims import set_prim_visibility

from tasks.base_task import BaseTask


class FlameTestTask(BaseTask):
    """Task definition for the 13-step flame test (焰色反应) on a bunsen burner."""

    # 常见金属离子焰色表（P10 灼烧时的受染颜色）
    FLAME_COLORS = {
        "yellow": (1.00, 0.85, 0.30),   # Na 钠：亮黄
        "purple": (0.80, 0.45, 1.00),   # K 钾：紫色
        "green": (0.35, 0.95, 0.40),    # Cu 铜：绿色
        "red": (1.00, 0.35, 0.25),      # Ca 钙：砖红
        "orange": (1.00, 0.60, 0.15),   # 橙黄
        "blue": (0.30, 0.60, 1.00),     # 冷色
    }

    # ---- 场景常量（与 lab_flametest.usd 布局一致）----
    TABLE_Z = 0.80
    # 铂丝（rotateY150°）：抓取点 = 手柄中心，尖端相对抓取点偏移
    WIRE_GRASP = np.array([0.228, -0.14, 0.898])
    WIRE_REST = np.array([0.20, -0.14, 0.9482])
    WIRE_TIP_OFFSET = np.array([0.05475, 0.0, -0.09303])
    # 各物体抓取点（夹爪指尖位置，任务用其检测"夹紧"）
    GRASP_POINTS = {
        "dish": np.array([0.32, -0.22, 0.807]),
        "hcl_stopper": np.array([0.12, 0.02, 0.875]),
        "dropper": np.array([0.12, -0.10, 0.90]),
        "sample_stopper": np.array([0.20, 0.12, 0.875]),
        "match": np.array([0.455, 0.24, 0.806]),
        "cap": np.array([0.46, 0.28, 0.83]),
    }
    # 物体静止位置（世界坐标；stopper 相对瓶、cap 相对 burner）
    REST_POS = {
        "dish": np.array([0.32, -0.22, 0.80]),
        "hcl_stopper": np.array([0.12, 0.02, 0.8735]),
        "dropper": np.array([0.12, -0.10, 0.80]),
        "sample_stopper": np.array([0.20, 0.12, 0.8735]),
        "match": np.array([0.50, 0.24, 0.80]),
        "cap": np.array([0.46, 0.28, 0.82]),
    }
    # 关键点
    BURNER_POS = np.array([0.36, 0.18, 0.80])
    FLAME_Z = (0.955, 1.045)          # 火焰区 z 范围（火焰 0.962-1.038，留裕量）
    IGNITE_POS = np.array([0.36, 0.18, 0.96])   # 火柴头点火位（灯口）
    MATCH_TIP_OFFSET = np.array([-0.053, 0.0, 0.0])  # 火柴头相对夹爪
    DROPPER_NOZZLE_OFFSET = np.array([0.0, 0.0, -0.10])  # 滴管口相对夹爪
    DISH_CENTER = np.array([0.20, 0.02])   # P1 表面皿中央位（xy）
    HCL_MOUTH = np.array([0.12, 0.02])     # 盐酸瓶口 xy
    SAMPLE_MOUTH = np.array([0.20, 0.12])  # 样品瓶口 xy
    CAP_ON_BURNER = np.array([0.0, 0.0, 0.16])  # 灯帽盖灯口（burner 局部坐标）
    WASH_NOZZLE = np.array([0.40, -0.10])  # 洗瓶喷嘴 xy
    JET_POS = np.array([0.40, -0.10, 0.885])  # 水柱位置（task 动态设置）

    def __init__(self, cfg, world, stage, robot):
        """Initialize the flame test task.

        Args:
            cfg: Configuration object for the task.
            world: The simulation world instance.
            stage: The USD stage for the simulation.
            robot: The robot instance used in the task.
        """
        super().__init__(cfg, world, stage, robot)

        self.dish_path = cfg.dish_path
        self.hcl_path = cfg.hcl_path
        self.hcl_stopper_path = self.hcl_path + "/stopper"
        self.dropper_path = cfg.dropper_path
        self.wire_path = cfg.wire_path
        self.sample_path = cfg.sample_path
        self.sample_stopper_path = self.sample_path + "/stopper"
        self.burner_path = cfg.burner_path
        self.cap_path = self.burner_path + "/cap"
        self.match_path = cfg.match_path
        self.droplet_path = cfg.droplet_path          # /World/Droplet
        self.jet_path = cfg.jet_path                  # /World/WaterJet
        self.dish_acid_path = cfg.dish_acid_path      # /World/DishAcid

        self.flame_color = getattr(cfg, "flame_color", "yellow")

        # 检测阈值
        self.grasp_xy_threshold = getattr(cfg, "grasp_xy_threshold", 0.03)
        self.gripper_closed_threshold = getattr(cfg, "gripper_closed_threshold", 0.025)
        self.gripper_open_threshold = getattr(cfg, "gripper_open_threshold", 0.03)
        self.ignite_dwell_frames = int(getattr(cfg, "ignite_dwell_frames", 15))
        self.stain_dwell_frames = int(getattr(cfg, "stain_dwell_frames", 150))
        self.extinguish_dwell_frames = int(getattr(cfg, "extinguish_dwell_frames", 15))
        self.drop_dwell_frames = int(getattr(cfg, "drop_dwell_frames", 20))
        self.drop_interval_frames = int(getattr(cfg, "drop_interval_frames", 30))
        self.n_drops = int(getattr(cfg, "n_drops", 3))

        # kinematic 物体注册: path, 父级路径(相对坐标)或 None
        self.kin_objs = {
            "dish": {"path": self.dish_path, "parent": None},
            "hcl_stopper": {"path": self.hcl_stopper_path, "parent": self.hcl_path},
            "dropper": {"path": self.dropper_path, "parent": None},
            "sample_stopper": {"path": self.sample_stopper_path, "parent": self.sample_path},
            "match": {"path": self.match_path, "parent": None},
            "cap": {"path": self.cap_path, "parent": self.burner_path},
        }
        # 注意：铂丝(wire)不在此表——它是"被任务驱动"的常持物体，走单独状态机
        self.wire_state = "rest"          # rest -> attached -> released
        self.attach_gripper_pos = None
        self._reset_kin_states()

    def _reset_kin_states(self):
        """Reset the kinematic per-object states."""
        for name in self.kin_objs:
            self.kin_objs[name]["state"] = "rest"   # rest/attached/released/settled
            self.kin_objs[name]["grasp_gripper"] = None
            self.kin_objs[name]["cur_world"] = None

    def reset(self):
        """Reset the task state: objects back to rest, flames/effects hidden."""
        super().reset()
        self.robot.initialize()

        # 物体回原位（铂丝保留 rotateY，只设 translate）
        self.object_utils.set_object_position(
            object_path=self.wire_path, position=self.WIRE_REST.copy()
        )
        for name, obj in self.kin_objs.items():
            self._set_obj_world(name, self.REST_POS[name])
        self._set_flame_visible(False)
        self._set_stain(False)
        self._set_visibility(self.droplet_path, False)
        self._set_visibility(self.jet_path, False)
        self._set_visibility(self.dish_acid_path, False)

        self.wire_state = "rest"
        self.attach_gripper_pos = None
        self.flame_on = False
        self.stain_on = False
        self.ignite_counter = 0
        self.stain_counter = 0
        self.extinguish_counter = 0
        self.drop_counter = 0
        self.drop_interval = 0
        self.n_dropped = 0
        self.jet_counter = 0
        self.jet_on = False
        self._reset_kin_states()

    def step(self):
        """Execute one simulation step.

        Returns:
            dict: State dictionary, or None if not ready.
        """
        self.frame_idx += 1
        if not self.check_frame_limits():
            return None

        self._update_objects_and_events()

        return self.get_basic_state_info(
            object_path=self.wire_path,
            additional_info={
                "flame_on": self.flame_on,
                "stain_on": self.stain_on,
                "flame_color": self.flame_color,
                "n_dropped": self.n_dropped,
                "wire_state": self.wire_state,
            },
        )

    # ------------------------------------------------------------------
    # 每帧更新：kinematic 跟随 + 事件检测
    # ------------------------------------------------------------------
    def _update_objects_and_events(self):
        gripper_pos = self.robot.get_gripper_position()
        joint_positions = self.robot.get_joint_positions()
        if gripper_pos is None or joint_positions is None:
            return
        gripper_opening = joint_positions[7]

        self._update_kin_objects(gripper_pos, gripper_opening)
        self._update_wire(gripper_pos, gripper_opening)
        self._update_effects(gripper_pos)

    def _update_kin_objects(self, gripper_pos, gripper_opening):
        """Attach / follow / release for dish, stoppers, dropper, match, cap."""
        for name, obj in self.kin_objs.items():
            if obj["state"] == "settled":
                continue

            if obj["state"] == "rest":
                grasp = self.GRASP_POINTS[name]
                near = (np.linalg.norm(gripper_pos[:2] - grasp[:2]) < self.grasp_xy_threshold
                        and abs(gripper_pos[2] - grasp[2]) < 0.03)
                if near and gripper_opening < self.gripper_closed_threshold:
                    obj["state"] = "attached"
                    obj["grasp_gripper"] = gripper_pos.copy()
                    obj["cur_world"] = self._get_obj_world(name)
                    print(f"[flametest] attached {name}")

            elif obj["state"] == "attached":
                # 镜像夹爪位移
                delta = gripper_pos - obj["grasp_gripper"]
                world = obj["cur_world"] + delta
                self._set_obj_world(name, world)
                if gripper_opening > self.gripper_open_threshold:
                    obj["state"] = "released"
                    self._settle_object(name)
                    print(f"[flametest] released {name}")

    def _update_wire(self, gripper_pos, gripper_opening):
        """Platinum wire lifecycle (always held from P5 to P12)."""
        if self.wire_state == "rest":
            near = (np.linalg.norm(gripper_pos[:2] - self.WIRE_GRASP[:2]) < self.grasp_xy_threshold
                    and abs(gripper_pos[2] - self.WIRE_GRASP[2]) < 0.03)
            if near and gripper_opening < self.gripper_closed_threshold:
                self.wire_state = "attached"
                self.attach_gripper_pos = gripper_pos.copy()
                print("[flametest] wire attached")

        elif self.wire_state == "attached":
            delta = gripper_pos - self.attach_gripper_pos
            self.object_utils.set_object_position(
                object_path=self.wire_path, position=self.WIRE_REST + delta
            )
            # 释放必须回到抓取位附近张开（P9 末尾放下 / P12 归位）；
            # 其它位置张开（如 P9 抓样品瓶塞、P11 放灯帽）不释放，否则 wire 中途脱落
            if (gripper_opening > self.gripper_open_threshold
                    and np.linalg.norm(gripper_pos - self.WIRE_GRASP) < 0.05):
                self.wire_state = "released"
                # 归位（P9 放下 / P12）：直接回初始斜置位
                self.object_utils.set_object_position(
                    object_path=self.wire_path, position=self.WIRE_REST.copy()
                )
                self.wire_state = "rest"
                print("[flametest] wire returned to rest")

    def _update_effects(self, gripper_pos):
        """Event detection: ignite / drop / stain / extinguish / water jet."""
        # ---- 1. 点燃（P4）：火柴头在灯口连续停留 -> 蓝色火焰 ----
        if not self.flame_on:
            if (self.kin_objs["match"]["state"] == "attached"
                    and self._match_tip(gripper_pos) is not None):
                tip = self._match_tip(gripper_pos)
                if np.linalg.norm(tip - self.IGNITE_POS) < 0.035:
                    self.ignite_counter += 1
                    if self.ignite_counter >= self.ignite_dwell_frames:
                        self.flame_on = True
                        self._set_flame_visible(True)
                        print("[flametest] flame ignited (blue)")
                else:
                    self.ignite_counter = 0
            else:
                self.ignite_counter = 0

        # ---- 2. 滴液（P3）：滴管口在表面皿上方 -> 滴 n_drops 滴 ----
        if (self.kin_objs["dropper"]["state"] == "attached"
                and self._nozzle(gripper_pos) is not None):
            nozzle = self._nozzle(gripper_pos)
            above_dish = (np.linalg.norm(nozzle[:2] - self.DISH_CENTER) < 0.035
                          and abs(nozzle[2] - 0.83) < 0.03)
            if above_dish:
                self.drop_counter += 1
                if self.drop_counter >= self.drop_dwell_frames and self.n_dropped < self.n_drops:
                    self.drop_interval += 1
                    if self.drop_interval >= self.drop_interval_frames:
                        self.n_dropped += 1
                        self.drop_interval = 0
                        # 显示一滴（短暂出现后隐藏），滴完显示皿内酸液
                        self._set_visibility(self.droplet_path, True)
                        if self.n_dropped >= self.n_drops:
                            self._set_visibility(self.dish_acid_path, True)
                        print(f"[flametest] drop {self.n_dropped}/{self.n_drops}")
            else:
                self.drop_counter = 0
                self.drop_interval = 0
        else:
            self.drop_counter = 0
            self.drop_interval = 0
        # 液滴闪显逻辑：每 2 帧刷新一次（显示期间可见）
        self._set_visibility(self.droplet_path,
                             self.n_dropped < self.n_drops and self.drop_counter > 0)

        # ---- 3. 受染（P10）：铂丝尖端在外焰连续停留 -> 接触处变色 ----
        if self.flame_on and self.wire_state == "attached":
            tip = gripper_pos + self.WIRE_TIP_OFFSET
            in_flame = (np.linalg.norm(tip[:2] - self.BURNER_POS[:2]) < 0.035
                        and self.FLAME_Z[0] < tip[2] < self.FLAME_Z[1])
            if in_flame:
                self.stain_counter += 1
                if self.stain_counter >= self.stain_dwell_frames and not self.stain_on:
                    self.stain_on = True
                    self._set_stain(True)
                    print(f"[flametest] stain {self.flame_color} revealed")
            else:
                if self.stain_counter > 0 or self.stain_on:
                    self.stain_counter = 0
                    if self.stain_on:
                        self.stain_on = False
                        self._set_stain(False)
        elif self.stain_on:
            self.stain_on = False
            self._set_stain(False)

        # ---- 4. 灭焰（P11）：灯帽盖到灯口 -> 火焰熄灭 ----
        if self.flame_on and self.kin_objs["cap"]["state"] == "attached":
            if np.linalg.norm(gripper_pos - np.array([0.36, 0.18, 0.96])) < 0.035:
                self.extinguish_counter += 1
                if self.extinguish_counter >= self.extinguish_dwell_frames:
                    self.flame_on = False
                    self.stain_on = False
                    self._set_flame_visible(False)
                    self._set_stain(False)
                    # 灯帽留在灯口（burner 局部坐标），不再参与 kinematic
                    self._set_obj_world("cap", np.array([0.36, 0.18, 0.96]))
                    self.kin_objs["cap"]["state"] = "settled"
                    print("[flametest] flame extinguished, cap on burner")
            else:
                self.extinguish_counter = 0

        # ---- 5. 水柱（P12/P13）：铂丝尖端或表面皿在洗瓶喷嘴下 -> 冲洗 ----
        jet_cond = False
        if self.wire_state == "attached":
            tip = gripper_pos + self.WIRE_TIP_OFFSET
            if (np.linalg.norm(tip[:2] - self.WASH_NOZZLE) < 0.035
                    and tip[2] < 0.88):
                jet_cond = True
        if (self.kin_objs["dish"]["state"] == "attached"
                and np.linalg.norm(gripper_pos[:2] - self.WASH_NOZZLE) < 0.035):
            jet_cond = True
        if jet_cond:
            self.jet_counter += 1
            if self.jet_counter >= 5 and not self.jet_on:
                self.jet_on = True
                self._set_obj_world_plain(self.jet_path, self.JET_POS)
                self._set_visibility(self.jet_path, True)
        else:
            self.jet_counter = 0
            if self.jet_on:
                self.jet_on = False
                self._set_visibility(self.jet_path, False)

    # ------------------------------------------------------------------
    # 辅助
    # ------------------------------------------------------------------
    def _match_tip(self, gripper_pos):
        """火柴头位置（火柴 attached 时有效）。"""
        return gripper_pos + self.MATCH_TIP_OFFSET

    def _nozzle(self, gripper_pos):
        """滴管口位置（滴管 attached 时有效）。"""
        return gripper_pos + self.DROPPER_NOZZLE_OFFSET

    def _get_obj_world(self, name):
        """读物体当前世界坐标（含父级偏移）。"""
        obj = self.kin_objs[name]
        local = self.object_utils.get_object_xform_position(obj["path"])
        if obj["parent"] is None:
            return local
        parent_t = self.object_utils.get_object_xform_position(obj["parent"])
        return local + parent_t

    def _set_obj_world(self, name, world):
        """写物体世界坐标（父级相对时换算成局部）。"""
        obj = self.kin_objs[name]
        if obj["parent"] is None:
            self.object_utils.set_object_position(object_path=obj["path"], position=world)
        else:
            parent_t = self.object_utils.get_object_xform_position(obj["parent"])
            self.object_utils.set_object_position(
                object_path=obj["path"], position=world - parent_t)

    def _set_obj_world_plain(self, path, world):
        """普通 prim（效果）直接设世界坐标。"""
        self.object_utils.set_object_position(object_path=path, position=world)

    def _settle_object(self, name):
        """释放后的落位规则。"""
        if name == "dish":
            # z 校正到桌面；P13 归位时 gripper 已在原位上方，x/y 自然回原位
            cur = self._get_obj_world(name)
            cur[2] = self.TABLE_Z
            self._set_obj_world(name, cur)
            self._set_visibility(self.dish_acid_path, False)  # 皿洗净
        elif name == "hcl_stopper":
            cur = self._get_obj_world(name)
            if np.linalg.norm(cur[:2] - self.HCL_MOUTH) < 0.025:
                cur[:] = self.REST_POS[name]                  # 盖回瓶口
            else:
                cur[2] = self.TABLE_Z + 0.068                 # 落桌面
            self._set_obj_world(name, cur)
        elif name == "sample_stopper":
            cur = self._get_obj_world(name)
            if np.linalg.norm(cur[:2] - self.SAMPLE_MOUTH) < 0.025:
                cur[:] = self.REST_POS[name]
            else:
                cur[2] = self.TABLE_Z + 0.068
            self._set_obj_world(name, cur)
        elif name in ("dropper", "match"):
            # 放回原位
            self._set_obj_world(name, self.REST_POS[name])
        self.kin_objs[name]["state"] = "rest"

    def _set_flame_visible(self, visible: bool) -> None:
        """显示/隐藏蓝色火焰（flame_outer 蓝焰 + flame_inner 白芯）。

        v3 burner：flame_outer 是蓝色外焰（无色火焰=蓝色外焰），受染色通过
        flame_stain_{color} 变体叠加（见 _set_stain），运行时不改 Shader。
        """
        for prim_name in ("flame_outer", "flame_inner"):
            prim = self.stage.GetPrimAtPath(f"{self.burner_path}/{prim_name}")
            if prim.IsValid():
                set_prim_visibility(prim, visible)

    def _set_stain(self, visible: bool) -> None:
        """显示/隐藏受染区（铂丝尖端接触处变色，6 色预制变体）。

        受染锥位于火焰包络内部，火焰材质不透明度高会遮挡黄色：
        受染时把 flame_outer/inner 材质 opacity 降到 0.25（黄区透出，
        视觉=火焰仅在铂丝处变黄），离开火焰后恢复 0.98。
        """
        for color in self.FLAME_COLORS:
            prim = self.stage.GetPrimAtPath(f"{self.burner_path}/flame_stain_{color}")
            if prim.IsValid():
                set_prim_visibility(prim, False)
        for mat_name in ("flame_outer_mat", "flame_inner_mat"):
            shader = self.stage.GetPrimAtPath(f"{self.burner_path}/{mat_name}/Shader")
            if shader.IsValid():
                attr = shader.GetAttribute("inputs:opacity")
                if attr:
                    attr.Set(0.25 if visible else 0.98)
        if visible:
            prim = self.stage.GetPrimAtPath(
                f"{self.burner_path}/flame_stain_{self.flame_color}")
            if prim.IsValid():
                set_prim_visibility(prim, True)

    def _set_visibility(self, path, visible):
        """安全地设置任意 prim 可见性（set_prim_visibility 需要 Prim 对象而非路径字符串）。"""
        try:
            prim = self.stage.GetPrimAtPath(path)
            if prim.IsValid():
                set_prim_visibility(prim, visible)
        except Exception:
            pass
